{
  "name": "@saf/desktop",
  "productName": "Steal A Fish",
  "version": "0.1.0",
  "private": true,
  "description": "TikTok Live interactive fishing game",
  "author": "tuskingcup",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win-zip": "electron-vite build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.31.0",
    "@saf/config": "workspace:*",
    "@saf/core": "workspace:*",
    "@saf/live": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
